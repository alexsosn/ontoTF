{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tfont.dev/schema/v2/profile.schema.json",
  "$defs": {
    "jsonScalar": {
      "type": ["string", "number", "boolean", "null"]
    },
    "evidenceBinding": {
      "type": "object",
      "required": ["evidence_id", "content_digest"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "content_digest": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "edgeStep": {
      "type": "object",
      "required": ["edge", "direction"],
      "properties": {
        "edge": {"type": "string", "minLength": 1},
        "direction": {"enum": ["outgoing", "incoming"]}
      },
      "additionalProperties": false
    },
    "componentPresentAssertion": {
      "type": "object",
      "maxProperties": 0,
      "additionalProperties": false
    },
    "nodeTypePresentAssertion": {
      "type": "object",
      "required": ["node_type"],
      "properties": {
        "node_type": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "featurePresentAssertion": {
      "type": "object",
      "required": ["node_type", "feature"],
      "properties": {
        "node_type": {"type": "string", "minLength": 1},
        "feature": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "edgePresentAssertion": {
      "type": "object",
      "required": ["edge", "direction"],
      "properties": {
        "edge": {"type": "string", "minLength": 1},
        "direction": {"enum": ["outgoing", "incoming"]}
      },
      "additionalProperties": false
    },
    "pathPresentAssertion": {
      "type": "object",
      "required": ["steps"],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/edgeStep"}
        }
      },
      "additionalProperties": false
    },
    "nativeValuePresentAssertion": {
      "type": "object",
      "required": ["node_type", "feature", "value", "value_semantics"],
      "properties": {
        "node_type": {"type": "string", "minLength": 1},
        "feature": {"type": "string", "minLength": 1},
        "value": {"$ref": "#/$defs/jsonScalar"},
        "value_semantics": {"const": "semantic"}
      },
      "additionalProperties": false
    },
    "valueDomainAssertion": {
      "type": "object",
      "required": ["node_type", "feature", "values", "domain_semantics"],
      "properties": {
        "node_type": {"type": "string", "minLength": 1},
        "feature": {"type": "string", "minLength": 1},
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/jsonScalar"}
        },
        "domain_semantics": {"enum": ["observed", "closed-reviewed"]}
      },
      "additionalProperties": false
    },
    "extentInterpretationAssertion": {
      "type": "object",
      "required": ["node_type", "interpretation"],
      "properties": {
        "node_type": {"type": "string", "minLength": 1},
        "interpretation": {
          "enum": ["textualExtent", "occurrenceSet", "technicalAnchor", "noSlot"]
        }
      },
      "additionalProperties": false
    },
    "dependency": {
      "type": "object",
      "required": ["dependency_id", "component_id", "kind", "assertion"],
      "properties": {
        "dependency_id": {"type": "string", "minLength": 1},
        "component_id": {"type": "string", "minLength": 1},
        "kind": {
          "enum": [
            "component-present",
            "node-type-present",
            "feature-present",
            "edge-present",
            "path-present",
            "native-value-present",
            "value-domain",
            "extent-interpretation"
          ]
        },
        "assertion": {"type": "object"},
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/evidenceBinding"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "component-present"}}, "required": ["kind"]},
          "then": {"properties": {"assertion": {"$ref": "#/$defs/componentPresentAssertion"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "node-type-present"}}, "required": ["kind"]},
          "then": {"properties": {"assertion": {"$ref": "#/$defs/nodeTypePresentAssertion"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "feature-present"}}, "required": ["kind"]},
          "then": {"properties": {"assertion": {"$ref": "#/$defs/featurePresentAssertion"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "edge-present"}}, "required": ["kind"]},
          "then": {"properties": {"assertion": {"$ref": "#/$defs/edgePresentAssertion"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "path-present"}}, "required": ["kind"]},
          "then": {"properties": {"assertion": {"$ref": "#/$defs/pathPresentAssertion"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "native-value-present"}}, "required": ["kind"]},
          "then": {"properties": {"assertion": {"$ref": "#/$defs/nativeValuePresentAssertion"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "value-domain"}}, "required": ["kind"]},
          "then": {"properties": {"assertion": {"$ref": "#/$defs/valueDomainAssertion"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "extent-interpretation"}}, "required": ["kind"]},
          "then": {"properties": {"assertion": {"$ref": "#/$defs/extentInterpretationAssertion"}}}
        },
        {
          "if": {
            "properties": {
              "kind": {"const": "value-domain"},
              "assertion": {
                "type": "object",
                "properties": {"domain_semantics": {"const": "closed-reviewed"}},
                "required": ["domain_semantics"]
              }
            },
            "required": ["kind", "assertion"]
          },
          "then": {
            "required": ["evidence"],
            "properties": {"evidence": {"minItems": 1}}
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "profile_version",
    "semantic_domains",
    "parent_component_manifest",
    "required_components",
    "ontology_locks",
    "mapping_sources",
    "dependency_contract_version",
    "dependencies",
    "minimum_tfont_runtime",
    "license"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "profile_id": {"type": "string", "minLength": 1},
    "profile_version": {"type": "string", "minLength": 1},
    "semantic_domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "profile_catalog_version": {"const": 1},
    "profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "structural", "linguistic", "lexical", "written-text", "textology", "heritage",
          "scholarly-inference", "archaeology", "scientific-analysis", "lexicography"
        ]
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "structural.entity-kind", "structural.slot-coverage", "structural.edge-traversal", "structural.section-navigation",
          "linguistic.part-of-speech", "linguistic.morphology", "linguistic.syntax", "linguistic.discourse",
          "lexical.entry", "lexical.form", "lexical.sense", "lexical.concept", "lexical.relation",
          "written-text.segment", "written-text.sign", "written-text.writing-system", "written-text.transcription-recognition",
          "textology.textual-version", "textology.witness", "textology.fragment-transmission", "textology.apparatus-reading",
          "textology.witness-attestation", "textology.explicit-omission",
          "heritage.physical-object", "heritage.physical-part", "heritage.identifier", "heritage.material",
          "heritage.place-provenance", "heritage.custody-location",
          "scholarly-inference.claim", "scholarly-inference.inference", "scholarly-inference.meaning-comprehension",
          "scholarly-inference.provenance-assessment"
        ]
      }
    },
    "parent_compatibility": {"enum": ["exact-only", "dependency-verified"]},
    "parent_component_manifest": {"type": "string", "minLength": 1},
    "required_components": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "ontology_locks": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "mapping_sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "dependency_contract_version": {"const": 1},
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/dependency"}
    },
    "minimum_tfont_runtime": {"type": "string", "minLength": 1},
    "license": {"type": "string", "minLength": 1},
    "provenance": {"type": "object"}
  },
  "additionalProperties": false
}
